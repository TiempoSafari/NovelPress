<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="拾卷 NovelPress" Manufacturer="TiempoSafari" Version="$(var.Version)" UpgradeCode="65C8B7ED-C963-4648-B921-E8C45EC60956" Scope="perUser" Language="2052" Codepage="936">
    <MajorUpgrade DowngradeErrorMessage="已安装较新的拾卷版本。" Schedule="afterInstallInitialize"/>
    <MediaTemplate EmbedCab="yes"/>
    <Icon Id="BookIcon" SourceFile="book.ico"/>
    <Property Id="ARPPRODUCTICON" Value="BookIcon"/>
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/TiempoSafari/NovelPress/releases"/>
    <Property Id="INSTALLFOLDER" Secure="yes">
      <RegistrySearch Id="LastFolder" Root="HKCU" Key="Software\TiempoSafari\NovelPress" Name="InstallLocation" Type="raw"/>
    </Property>
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserPrograms" Name="Programs"><Directory Id="INSTALLFOLDER" Name="NovelPress">
        <Component Id="Application" Guid="A2ED32B7-8C8D-4EE5-A471-CAB2AB3167AC">
          <File Id="UpdateRunner" Source="artifacts/staging/UpdateRunner.exe"/>
          <File Id="AppExe" Source="artifacts/staging/NovelPress.exe"/>
          <Shortcut Id="StartMenu" Directory="ProgramMenuFolder" Name="拾卷 NovelPress" Target="[#AppExe]" WorkingDirectory="INSTALLFOLDER" Icon="BookIcon"/>
          <RegistryValue Root="HKCU" Key="Software\TiempoSafari\NovelPress" Name="InstallLocation" Value="[INSTALLFOLDER]" Type="string" KeyPath="yes"/>
        </Component>
        <Directory Id="Bundled" Name="bundled-plugins">
          <Component Id="Rules" Guid="68284C45-5E50-4732-A372-31BE9FBE89B1">
            <File Source="plugins/esjzone.cc.json"/><File Source="plugins/silvernoelle.com.json"/><File Source="plugins/zh.wikisource.org.json"/><File Source="plugins/插件编写说明.md"/>
            <RegistryValue Root="HKCU" Key="Software\TiempoSafari\NovelPress" Name="Rules" Value="$(var.Version)" Type="string" KeyPath="yes"/>
          </Component>
        </Directory>
      </Directory></Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder"/>
    <Feature Id="Main" Title="拾卷" Level="1"><ComponentRef Id="Application"/><ComponentRef Id="Rules"/></Feature>
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER"/>
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="99" Condition="NOT Installed"/>
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="99"/>
    </UI>
  </Package>
</Wix>
